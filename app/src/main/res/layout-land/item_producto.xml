<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCaja"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/scently_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="92dp"
                android:layout_height="92dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/scently_background">

                <ImageView
                    android:id="@+id/ivItemFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_caja" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvItemCodigo"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/scently_primary"
                android:gravity="center"
                android:text="#101"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Fragancia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/scently_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvItemMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Casa / Diseñador"
                android:textSize="12sp"
                android:textColor="@color/scently_text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvItemPrecioOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/scently_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvItemPrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$ 0.0"
                android:textColor="@color/scently_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvItemEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN STOCK"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/scently_accent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center" />

    </LinearLayout>

</androidx.cardview.widget.CardView>